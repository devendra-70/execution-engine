# =============================================================================
# CODEVAL EXECUTION ENGINE — LOCAL DEVELOPMENT ENVIRONMENT VARIABLES
# =============================================================================
# This file is the single source of truth for ALL configurable values in local
# development. It is loaded automatically by docker-compose.
#
# DO NOT commit real secrets. This file contains safe local-only defaults.
# For production, inject these via AWS Secrets Manager / ECS task env vars.
# =============================================================================


# -----------------------------------------------------------------------------
# SPRING PROFILE
# 'dev' activates the DevTokenController (/api/dev/token) for local testing.
# Remove or change to 'prod' before any real deployment.
# -----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev


# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------
SERVER_PORT=8080


# -----------------------------------------------------------------------------
# POSTGRESQL (Connection)
# The engine connects to the 'postgres' service defined in docker-compose.yml
# -----------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=codeval
DB_USER=codeval
DB_PASS=codeval


# -----------------------------------------------------------------------------
# POSTGRESQL (JPA / Hibernate behaviour)
# SPRING_JPA_DDL_AUTO:
#   'update'   — auto-creates/migrates schema (safe for local dev)
#   'validate' — only validates schema (recommended for production)
#   'none'     — do nothing (use Flyway/Liquibase instead)
# HIBERNATE_BATCH_SIZE: number of rows batched per INSERT statement
# SPRING_JPA_SHOW_SQL: logs every SQL query to console (noisy, disable in prod)
# -----------------------------------------------------------------------------
SPRING_JPA_DDL_AUTO=update
HIBERNATE_BATCH_SIZE=50
SPRING_JPA_SHOW_SQL=false


# -----------------------------------------------------------------------------
# REDIS
# APP_REDIS_STATUS_TTL_SECONDS: how long execution:status:{id} keys live in Redis
# APP_REDIS_RATE_LIMIT_RPM:     max API requests per user per minute
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
APP_REDIS_STATUS_TTL_SECONDS=600
APP_REDIS_RATE_LIMIT_RPM=5


# -----------------------------------------------------------------------------
# KAFKA
# APP_KAFKA_TOPIC:       topic name submissions are published to
# APP_KAFKA_PARTITIONS:  number of topic partitions (sets max parallelism)
# APP_KAFKA_CONCURRENCY: Thread Pool A — number of Kafka listener threads
# KAFKA_BOOTSTRAP:       broker address reachable from the engine container
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP=codeval-kafka:29092
APP_KAFKA_TOPIC=execution-tasks
APP_KAFKA_PARTITIONS=50
APP_KAFKA_CONCURRENCY=25


# -----------------------------------------------------------------------------
# EXECUTION ORCHESTRATOR (Thread Pool B + Timeouts)
# APP_EXECUTION_ORCHESTRATION_THREADS: Thread Pool B — sandbox I/O workers
# APP_EXECUTION_TIMEOUT_MS:            hard TLE timeout per submission (ms)
# -----------------------------------------------------------------------------
APP_EXECUTION_ORCHESTRATION_THREADS=50
APP_EXECUTION_TIMEOUT_MS=3000


# -----------------------------------------------------------------------------
# SANDBOX CONTAINER POOL
# APP_EXECUTION_POOL_WARM_MIN_SIZE:    number of containers pre-warmed on startup
# APP_EXECUTION_POOL_IDLE_TTL_SECONDS: idle container recycled after this many seconds
# -----------------------------------------------------------------------------
APP_EXECUTION_POOL_WARM_MIN_SIZE=3
APP_EXECUTION_POOL_IDLE_TTL_SECONDS=300


# -----------------------------------------------------------------------------
# SANDBOX JVM RESOURCE LIMITS (injected into `docker run` by the Orchestrator)
# APP_SANDBOX_MEMORY_LIMIT_MB: Docker cgroup memory cap for sandbox containers
# APP_SANDBOX_JVM_XMS:         sandbox JVM initial heap
# APP_SANDBOX_JVM_XMX:         sandbox JVM max heap
# -----------------------------------------------------------------------------
APP_SANDBOX_MEMORY_LIMIT_MB=256
APP_SANDBOX_JVM_XMS=128m
APP_SANDBOX_JVM_XMX=256m


# -----------------------------------------------------------------------------
# CAFFEINE LOCAL CACHE
# APP_CACHE_TESTCASE_TTL_MINUTES: how long test-case lists are cached in JVM memory
# -----------------------------------------------------------------------------
APP_CACHE_TESTCASE_TTL_MINUTES=60


# -----------------------------------------------------------------------------
# DOCKER (how the engine spawns sandbox containers)
# DOCKER_HOST:    Docker daemon socket
#   Windows Docker Desktop → tcp://localhost:2375  (enable "Expose daemon on TCP" in settings)
#   Linux / ECS            → unix:///var/run/docker.sock
# SANDBOX_IMAGE:  image pulled by the engine to create sandbox containers
# SANDBOX_HOST:   hostname the engine uses to reach sandbox-mapped ports
#   Inside docker-compose → host.docker.internal
#   Local dev (no compose) → localhost
# -----------------------------------------------------------------------------
DOCKER_HOST=unix:///var/run/docker.sock
SANDBOX_IMAGE=codeval/sandbox-wrapper:latest
SANDBOX_HOST=host.docker.internal


# -----------------------------------------------------------------------------
# JWT AUTHENTICATION
# ⚠️  CHANGE THIS before any shared/staging deployment.
# Minimum 32 characters for HS256.
# -----------------------------------------------------------------------------
JWT_SECRET=changeme-very-long-secret-key-for-dev-only-32chars


# -----------------------------------------------------------------------------
# LOGGING LEVELS
# Options: TRACE | DEBUG | INFO | WARN | ERROR
# -----------------------------------------------------------------------------
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_KAFKA=INFO
LOG_LEVEL_SECURITY=INFO


# -----------------------------------------------------------------------------
# KAFKA UI (Provectus) — local observability tool
# KAFKA_UI_PORT: host port to access the UI at http://localhost:<port>
# -----------------------------------------------------------------------------
KAFKA_UI_PORT=8090

