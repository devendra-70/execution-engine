{
  "info": {
    "name": "Execution Engine Service",
    "_postman_id": "execution-engine-service-collection",
    "description": "Complete API test collection for the CodEval Execution Engine Service.\n\nBase URL: http://localhost:8080\n\n## Setup\n1. Set the `jwt_token` collection variable to your Google OAuth2 Bearer token.\n2. Make sure Docker services are running: `docker compose up -d`\n3. App must be running on port 8080.\n\n## Getting a Google JWT Token\n- Visit: https://developers.google.com/oauthplayground/\n- Authorize and get an access_token\n- Paste it into the `jwt_token` variable below.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "PASTE_YOUR_GOOGLE_JWT_TOKEN_HERE",
      "type": "string"
    },
    {
      "key": "execution_id",
      "value": "",
      "type": "string",
      "description": "Auto-populated from Submit Execution response"
    }
  ],
  "item": [
    {
      "name": "1. Health & Monitoring",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/actuator/health",
              "host": ["{{base_url}}"],
              "path": ["actuator", "health"]
            },
            "description": "Public endpoint — no auth required.\nUsed by AWS ALB/ECS as health probe.\n\nExpected: 200 OK\n{\n  \"status\": \"UP\"\n}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Health status is UP', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('UP');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": [
            {
              "name": "200 OK - App is healthy",
              "status": "OK",
              "code": 200,
              "body": "{\"status\":\"UP\"}"
            }
          ]
        }
      ]
    },
    {
      "name": "2. Submit Execution (Happy Path)",
      "item": [
        {
          "name": "Submit Code - RUN mode (Java)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 202 Accepted', function () {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "pm.test('Response has executionId', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.executionId).to.be.a('string');",
                  "    pm.collectionVariables.set('execution_id', json.executionId);",
                  "});",
                  "pm.test('Status is PENDING', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('PENDING');",
                  "});",
                  "pm.test('Response has submittedAt timestamp', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.submittedAt).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"problemId\": \"two-sum\",\n  \"language\": \"java21\",\n  \"mode\": \"RUN\",\n  \"sourceCode\": \"public class Solution {\\n  public int[] twoSum(int[] nums, int target) {\\n    java.util.Map<Integer, Integer> map = new java.util.HashMap<>();\\n    for (int i = 0; i < nums.length; i++) {\\n      int complement = target - nums[i];\\n      if (map.containsKey(complement)) return new int[]{map.get(complement), i};\\n      map.put(nums[i], i);\\n    }\\n    return new int[]{};\\n  }\\n}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/executions",
              "host": ["{{base_url}}"],
              "path": ["api", "executions"]
            },
            "description": "Submit a Two Sum solution in RUN mode.\n\nExpected: 202 Accepted\n{\n  \"executionId\": \"<uuid>\",\n  \"status\": \"PENDING\",\n  \"submittedAt\": \"2026-05-11T09:45:00.123Z\"\n}\n\nThe executionId is auto-saved to the `execution_id` collection variable."
          },
          "response": [
            {
              "name": "202 Accepted - Execution queued",
              "status": "Accepted",
              "code": 202,
              "body": "{\n  \"executionId\": \"3f7a1b2c-4d5e-6f7a-8b9c-0d1e2f3a4b5c\",\n  \"status\": \"PENDING\",\n  \"submittedAt\": \"2026-05-11T09:45:00.123Z\"\n}"
            }
          ]
        },
        {
          "name": "Submit Code - SUBMIT mode (Java)",
