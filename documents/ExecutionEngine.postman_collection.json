                  "});",
                  "pm.test('Response has executionId', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.executionId).to.be.a('string');",
                  "    pm.collectionVariables.set('execution_id', json.executionId);",
                  "});",
                  "pm.test('Status is PENDING', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('PENDING');",
                  "});"
                ],
