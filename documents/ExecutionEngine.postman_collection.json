            "description": "Submit a Fibonacci solution in SUBMIT mode (scored, persisted to DB).\n\nExpected: 202 Accepted\n{\n  \"executionId\": \"<uuid>\",\n  \"status\": \"PENDING\",\n  \"submittedAt\": \"...\"\n}"
          }
