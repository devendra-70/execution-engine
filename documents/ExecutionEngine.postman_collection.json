            "body": {
              "mode": "raw",
              "raw": "{\n  \"problemId\": \"fibonacci\",\n  \"language\": \"java21\",\n  \"mode\": \"SUBMIT\",\n  \"sourceCode\": \"public class Solution {\\n  public int fib(int n) {\\n    if (n <= 1) return n;\\n    return fib(n - 1) + fib(n - 2);\\n  }\\n}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
