    {
      "name": "5. Rate Limiting (429)",
      "item": [
        {
          "name": "Trigger Rate Limit",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// This single request won't trigger 429 by itself.",
                  "// Run this request 31+ times in quick succession using",
                  "// Postman Runner with iterations > 30 to trigger 429.",
                  "pm.test('Response received', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([202, 429]);",
                  "});",
                  "if (pm.response.code === 429) {",
                  "    pm.test('Rate limit error structure is correct', function () {",
                  "        const json = pm.response.json();",
                  "        pm.expect(json.status).to.eql(429);",
                  "        pm.expect(json.error).to.eql('Rate Limit Exceeded');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"problemId\": \"rate-limit-test\",\n  \"language\": \"java21\",\n  \"mode\": \"RUN\",\n  \"sourceCode\": \"public class Solution {}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/executions",
              "host": ["{{base_url}}"],
              "path": ["api", "executions"]
            },
            "description": "Rate limit is 30 requests/minute per user/IP (configured in application.properties).\n\nTo trigger 429:\n- Use Postman Collection Runner\n- Set Iterations to 35\n- Set Delay to 0ms\n- After 30 requests, you will receive:\n\n{\n  \"status\": 429,\n  \"error\": \"Rate Limit Exceeded\",\n  \"message\": \"Rate limit exceeded for user: <userId> (max 30 requests per minute)\",\n  \"timestamp\": \"...\"\n}"
          }
        }
      ]
